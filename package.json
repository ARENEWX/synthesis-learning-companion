{
  "name": "synthesis-learning-companion",
  "version": "0.1.2",
  "description": "Selection-based AI tutoring, English reading voices, and durable learning cards for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "learning",
    "ai-tutor",
    "vocabulary",
    "text-to-speech"
  ],
  "author": "ARENEWX",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@microsoft/eslint-plugin-sdl": "1.1.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/scope-manager": "8.48.1",
    "@typescript-eslint/types": "8.48.1",
    "@typescript-eslint/utils": "8.48.1",
    "@typescript-eslint/visitor-keys": "8.48.1",
    "esbuild": "^0.28.2",
    "eslint": "9.39.1",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "obsidian": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "^4.0.15"
  }
}
